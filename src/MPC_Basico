import random

M = 1000003


def dividir_secreto(x, modulo=M):
    # Genera dos partes aleatorias
    s1 = random.randint(0, modulo - 1)
    s2 = random.randint(0, modulo - 1)

    # Calcula la tercera parte
    s3 = (x - s1 - s2) % modulo

    return s1, s2, s3


def suma_secreta(notas, modulo=M):
    # Cada servidor almacenará una parte de todas las notas
    servidor1 = []
    servidor2 = []
    servidor3 = []

    # Dividir cada nota en tres partes
    for nota in notas:
        s1, s2, s3 = dividir_secreto(nota, modulo)
        servidor1.append(s1)
        servidor2.append(s2)
        servidor3.append(s3)

    # Cada servidor calcula la suma de sus partes
    suma1 = sum(servidor1) % modulo
    suma2 = sum(servidor2) % modulo
    suma3 = sum(servidor3) % modulo

    # Reconstrucción de la suma total
    suma_total = (suma1 + suma2 + suma3) % modulo

    # Promedio
    promedio = suma_total / len(notas)

    return suma_total, promedio


# Programa principal
cantidad = int(input("¿Cuántas notas desea ingresar?: "))

notas = []
for i in range(cantidad):
    nota = int(input(f"Nota {i + 1} (0-50): "))
    while nota < 0 or nota > 50:
        nota = int(input("La nota debe estar entre 0 y 50. Intente nuevamente: "))
    notas.append(nota)

suma, promedio = suma_secreta(notas)

print("\nRESULTADOS")
print("Suma total =", suma)
print("Promedio =", promedio)
